# Zeilenenden: im Repo LF, im Working Tree plattformgerecht (Windows = CRLF für Text).
* text=auto eol=lf

# .NET / Visual Studio auf Windows erwarten CRLF in diesen Dateien
*.cs   text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.manifest text eol=crlf
*.sln    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.bat    text eol=crlf

*.md    text eol=lf

# Binär
*.ico    binary
*.png    binary
*.jpg    binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.exe    binary
*.dll    binary
*.pdb    binary
