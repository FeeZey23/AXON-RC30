<Project>

  <!-- Gilt für alle Projekte im Repository (src/*, tests/*). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>

    <Company>ISAS</Company>
    <Product>ISAS - AXON-RC30</Product>
    <Copyright>Copyright © 2026</Copyright>

    <!-- Keine Resx-Nebenprodukte fremder Pakete im Output -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeOpenAPIAnalyzersForControllers>false</IncludeOpenAPIAnalyzersForControllers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Import Project="Version.props" />
</Project>
