<Window x:Class="ArenaDesktopCompanion.ConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konflikte entscheiden" Height="700" Width="1080"
        MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource Brush.Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Header}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Konflikte entscheiden" FontSize="{StaticResource Size.Headline}" FontWeight="Bold"/>
                <TextBlock x:Name="TxtHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Diese Dateien haben sich seit dem letzten Import verändert. Entscheide pro Datei – nichts wird überschrieben, ohne dass du es gesehen hast."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Links: offene Anfragen -->
            <GroupBox Grid.Column="0" Header="Offene Konflikte" Margin="0,0,14,0">
                <ListBox x:Name="LstConflicts" SelectionChanged="LstConflicts_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Relative}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SubLine}" Style="{StaticResource Text.Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- Rechts: was steht wo -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,6">
                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource Brush.Success}"/>
                    <TextBlock Text="Meine Datei (unverändert)" Style="{StaticResource Text.Caption}" Margin="7,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,6">
                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource Brush.Accent}"/>
                    <TextBlock Text="Arena-Version" Style="{StaticResource Text.Caption}" Margin="7,0,0,0"/>
                </StackPanel>

                <TextBox x:Name="TxtMine" Grid.Row="1" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"
                         Style="{StaticResource TextBox.Mono}" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AcceptsReturn="True"/>
                <TextBox x:Name="TxtArena" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="8,0,0,0"
                         Style="{StaticResource TextBox.Mono}" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AcceptsReturn="True"/>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="10" Padding="12,10"
                        Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1" MaxHeight="170" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border Width="3" Height="13" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Info}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtDiffLabel" Text="kein Unterschied" VerticalAlignment="Center"
                                       FontSize="{StaticResource Size.Caption}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                        </StackPanel>
                        <TextBox x:Name="TxtDiff" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Brush.TextMuted}" Padding="0"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}"
                                 MaxHeight="110" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Unten: Aktionen -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Header}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vorlage öffnen" Click="BtnOpenTemplate_Click"
                        Style="{StaticResource Btn.Outline}" HorizontalAlignment="Left"
                        ToolTip="decisions.json im Editor öffnen – auch für mehrere Dateien auf einmal"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Meine behalten" Click="BtnKeepMine_Click" Style="{StaticResource Btn.Outline}"
                            Margin="0,0,8,0" ToolTip="Deine Datei bleibt, die Arena-Version wandert in den Konfliktordner"/>
                    <Button Content="Beide behalten" Click="BtnBoth_Click" Style="{StaticResource Btn.Info}"
                            Margin="0,0,8,0"
                            ToolTip="Meine Datei bleibt, die Arena-Version kommt zusätzlich daneben (datei.arena.py)"/>
                    <Button Content="Arena übernehmen" Click="BtnArena_Click" Style="{StaticResource Btn.Success}"
                            Margin="0,0,8,0" ToolTip="Meine Version wird vorher in den Ordner Backup\ gesichert"/>
                    <Button Content="Alle übernehmen" Click="BtnApplyAll_Click" Style="{StaticResource Btn.Primary}"
                            Margin="0,0,8,0"
                            ToolTip="Alle bereits beantworteten Anfragen aus der Vorlage umsetzen"/>
                    <Button Content="Schließen" Click="BtnClose_Click" Style="{StaticResource Btn.Outline}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
