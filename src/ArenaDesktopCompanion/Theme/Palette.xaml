<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ============================================================================
        Palette – die einzige Stelle, an der Farben und Schriften definiert sind.
        Vorher standen Hex-Werte in drei Fenstern verstreut; eine Farbänderung war
        damit eine Suche in vier Dateien. Hier gilt: Fenster benutzen nur noch
        {StaticResource Brush.*} / {StaticResource Font.*}.
        ============================================================================
    -->

    <sys:String x:Key="Theme.Name">Arena Dark</sys:String>

    <!-- === Flächen (dunkles Schiefer, drei Stufen Tiefe) === -->
    <Color x:Key="Color.Bg">#FF0A0F16</Color>
    <Color x:Key="Color.Surface">#FF0C1420</Color>
    <Color x:Key="Color.Card">#FF111A26</Color>
    <Color x:Key="Color.CardHover">#FF16202E</Color>
    <Color x:Key="Color.Input">#FF0D1523</Color>
    <Color x:Key="Color.Selected">#FF14283C</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}"/>
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}"/>
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>

    <!-- === Linien === -->
    <Color x:Key="Color.Border">#FF1C2A3C</Color>
    <Color x:Key="Color.BorderStrong">#FF2A3D52</Color>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>

    <!-- === Text === -->
    <Color x:Key="Color.Text">#FFE8F0F8</Color>
    <Color x:Key="Color.TextMuted">#FF9FB2C6</Color>
    <Color x:Key="Color.TextDim">#FF6B7F95</Color>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}"/>

    <!-- === Akzente === -->
    <Color x:Key="Color.Accent">#FF63B4EC</Color>
    <Color x:Key="Color.AccentSoft">#FF1B3A55</Color>
    <Color x:Key="Color.Success">#FF5FD3A3</Color>
    <Color x:Key="Color.SuccessSoft">#FF12352A</Color>
    <Color x:Key="Color.Info">#FF7CC7F2</Color>
    <Color x:Key="Color.InfoSoft">#FF103246</Color>
    <Color x:Key="Color.Warn">#FFE2B469</Color>
    <Color x:Key="Color.WarnSoft">#FF3A2C10</Color>
    <Color x:Key="Color.Danger">#FFEF6A6A</Color>
    <Color x:Key="Color.Violet">#FF9C8BFF</Color>
    <Color x:Key="Color.VioletSoft">#FF241F47</Color>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.InfoSoft}"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}"/>
    <SolidColorBrush x:Key="Brush.VioletSoft" Color="{StaticResource Color.VioletSoft}"/>

    <!-- === Verläufe (geben Knöpfen und Kopfzeile Tiefe) === -->
    <LinearGradientBrush x:Key="Brush.Header" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF16203A" Offset="0"/>
        <GradientStop Color="#FF0E1730" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6D5EF8" Offset="0"/>
        <GradientStop Color="#FF22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5B84FF" Offset="0"/>
        <GradientStop Color="#FF3D63D9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7498FF" Offset="0"/>
        <GradientStop Color="#FF4A73EB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3D63D9" Offset="0"/>
        <GradientStop Color="#FF2F4DB0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SuccessButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2FD977" Offset="0"/>
        <GradientStop Color="#FF159E52" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.InfoButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2FC3E8" Offset="0"/>
        <GradientStop Color="#FF0E93B8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.WarnButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDBA3B" Offset="0"/>
        <GradientStop Color="#FFD98A06" Offset="1"/>
    </LinearGradientBrush>

    <!-- === Schriften === -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>
    <!-- Windows 11 liefert Fluent Icons, Windows 10 die MDL2-Vorgängerin – die Codepoints sind gleich. -->

    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Body">12</sys:Double>
    <sys:Double x:Key="Size.Title">13</sys:Double>
    <sys:Double x:Key="Size.Headline">17</sys:Double>

    <!-- === Textbausteine === -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Fenster- und Abschnittstitel: eine Zeile, Akzentbalken davor -->
    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Size.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    </Style>

    <Style x:Key="Text.Dim" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
    </Style>

    <!-- Ikonenschrift (Segoe Fluent Icons / MDL2) -->
    <!-- Globale Grundschrift: Wer nichts anderes sagt, bekommt die helle Schrift auf dunklem Grund.
         Lokale Werte am Element haben weiter Vorrang – der Stil setzt nur, was sonst fehlt. -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>

    <!-- === Tastatur-Fokus (Sichtbarkeit ist Teil der Bedienbarkeit) === -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" StrokeThickness="1.5"
                               Stroke="{StaticResource Brush.Info}" StrokeDashArray="2 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
