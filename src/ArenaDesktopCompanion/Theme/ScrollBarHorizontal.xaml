<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Waagerechte Bildlaufleiste als Vorlage. -->
    <ControlTemplate x:Key="ScrollBar.Template.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" MinWidth="24"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Die nackte Bildlaufleiste bekommt die senkrechte Vorlage; ist sie waagerecht,
         tauscht der Auslöser Vorlage UND Größe. Die Größe muss hier stehen und nicht in
         der Vorlage: die Leiste selbst braucht sie, sonst legt der ScrollViewer sie auf
         fast null Breite. Diese Datei wird ZULETZT von den beiden Bildlauf-Dateien
         eingebunden, damit beide Vorlagen bekannt sind. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.Template.Vertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Template" Value="{StaticResource ScrollBar.Template.Horizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
